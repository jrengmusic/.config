{
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5-2",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5",
    "BASH_MAX_TIMEOUT_MS": "900000",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read",
      "Glob",
      "WebFetch(*)",
      "WebSearch(*)"
    ],
    "deny": [
      "CronCreate",
      "CronDelete",
      "CronList",
      "ScheduleWakeup",
      "EnterWorktree",
      "ExitWorktree",
      "NotebookEdit",
      "Edit",
      "Write",
      "Grep",
      "TodoWrite"
    ],
    "ask": [
      "Bash(git restore*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git reset*)",
      "Bash(git stash*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(python*)",
      "Bash(python3*)",
      "Bash(lua*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "skillOverrides": {
    "dataviz": "off",
    "claude-api": "off",
    "schedule": "off",
    "loop": "off",
    "run": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"CAROL PROTOCOL ACTIVE — CAROL.md is loaded. Address the user as ARCHITECT. Be concise — no flattery, no emojis, no trailing summaries. Read @mentioned files, referenced paths, and project docs immediately, without asking. Never ask a question that a read can answer. Never assume. Never decide — correct course against CONTRACT. Before the plan locks, discuss before executing changes. After the lock, execute to the endpoint; a stop before it triggers CAROL.md Step Gate.\"}}'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.carol/bin/carol-statusline.sh"
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "cc-plugin-easel@builtin": false
  },
  "outputStyle": "CAROL",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-2": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-haiku-5-5": {
      "effortLevel": "medium"
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "switchModelsOnFlag": false,
  "showTurnDuration": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
